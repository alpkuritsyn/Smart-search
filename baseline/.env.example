# Скопируйте файл в .env и заполните реальные ключи.
# Выберите провайдер: gemini или yandexgpt
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Настройки YandexGPT API (включая DeepSeek-V4-Flash в Yandex Cloud)
YANDEX_API_KEY=your_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=deepseek-v4-flash

HOST=127.0.0.1
PORT=8000
MAX_USER_MESSAGE_CHARS=400
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_TIMEOUT_SECONDS=60
