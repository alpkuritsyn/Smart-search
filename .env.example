# Runtime demo. Скопируйте в .env и не добавляйте .env в Git.
SMART_SEARCH_V1_ENABLED=true
HOST=127.0.0.1
PORT=8000

# Graphify -> local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b
OLLAMA_API_KEY=ollama
GRAPHIFY_OLLAMA_NUM_CTX=32768
GRAPHIFY_OLLAMA_KEEP_ALIVE=30m

# Узкий local embedding entity resolver. Не переиспользует Graphify model.
SMART_SEARCH_ENTITY_RESOLVER_MODE=off
ENTITY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
ENTITY_EMBEDDING_MODEL=qwen3-embedding:0.6b
ENTITY_EMBEDDING_TIMEOUT_SECONDS=20

# Только для offline Gemini graph review; runtime-поиск ключ не использует.
GEMINI_API_KEY=
GEMINI_TEST_MODEL=gemini-3.1-flash-lite
